          "id": "45131ff8-89eb-48c3-9d70-9fd7f1717363",
          "name": "Search CVE records",
          "request": {
            "name": "Search CVE records",
            "description": {
              "content": "Returns a paginated list of CVE records that match the supplied filter parameters. Supports filters by CVE ID, keyword, CPE, CVSS metrics, publication and modification dates.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "cves",
                "2.0"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "cveId",
                  "value": "<string>",
                  "description": "Returns a single CVE record by its CVE identifier."
                },
                {
                  "disabled": false,
                  "key": "cpeName",
                  "value": "<string>",
                  "description": "Returns CVE records associated with the supplied CPE 2.3 name."
                },
                {
                  "disabled": false,
                  "key": "cvssV3Severity",
                  "value": "<string>",
                  "description": "Filter results by CVSS v3 qualitative severity rating."
                },
                {
                  "disabled": false,
                  "key": "keywordSearch",
                  "value": "<string>",
                  "description": "Returns CVE records where the description contains the keyword."
                },
                {
                  "disabled": false,
                  "key": "pubStartDate",
                  "value": "<dateTime>",
                  "description": "Filter by CVE publish start date (ISO 8601)."
                },
                {
                  "disabled": false,
                  "key": "pubEndDate",
                  "value": "<dateTime>",
                  "description": "Filter by CVE publish end date (ISO 8601)."
                },
                {
                  "disabled": false,
                  "key": "lastModStartDate",
                  "value": "<dateTime>",
                  "description": "Filter by last modified start date (ISO 8601)."
                },
                {
                  "disabled": false,
                  "key": "lastModEndDate",
                  "value": "<dateTime>",
                  "description": "Filter by last modified end date (ISO 8601)."
                },
                {
                  "disabled": false,
                  "key": "resultsPerPage",
                  "value": "2000",
                  "description": "Number of CVE records to return per page (max 2000)."
                },
                {
                  "disabled": false,
                  "key": "startIndex",
                  "value": "0",
                  "description": "Zero-based offset into the result set."
                }
              ],
              "variable": []
            },
            "header": [
