    {
      "id": "14609739-d976-469e-8c44-82f4a0341bea",
      "name": "Retrieve CVE change history",
      "request": {
        "name": "Retrieve CVE change history",
        "description": {
          "content": "Returns the change history of CVE records, including modifications to descriptions, references, configurations, and CVSS metrics.",
          "type": "text/plain"
        },
        "url": {
          "path": [
            "cvehistory",
            "2.0"
          ],
          "host": [
            "{{baseUrl}}"
          ],
          "query": [
            {
              "disabled": false,
              "key": "cveId",
              "value": "<string>",
              "description": "Returns the change history for a single CVE."
            },
            {
              "disabled": false,
              "key": "changeStartDate",
              "value": "<dateTime>",
              "description": "Filter changes that occurred on or after this date (ISO 8601)."
            },
            {
              "disabled": false,
              "key": "changeEndDate",
              "value": "<dateTime>",
              "description": "Filter changes that occurred on or before this date (ISO 8601)."
            },
            {
              "disabled": false,
              "key": "resultsPerPage",
              "value": "5000",
              "description": "Number of change records to return per page (max 5000)."
            },
            {
              "disabled": false,
              "key": "startIndex",
              "value": "0",
              "description": "Zero-based offset into the result set."
            }
          ],
          "variable": []
        },
        "header": [
